{
  "name": "japan-invoice-mcp",
  "version": "0.1.1",
  "description": "MCP server for Japanese invoices (インボイス制度): registration number check, consumption tax by rate, withholding tax. Offline, no API keys.",
  "type": "module",
  "bin": {
    "japan-invoice-mcp": "src/server.js"
  },
  "exports": "./src/index.js",
  "files": [
    "src",
    "MAINTENANCE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "demo": "node examples/demo.js",
    "verify:package": "node scripts/verify-package.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "japan",
    "japanese",
    "invoice",
    "consumption-tax",
    "withholding-tax",
    "claude",
    "codex",
    "インボイス",
    "適格請求書",
    "消費税",
    "源泉徴収",
    "法人番号"
  ],
  "author": "Ash",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashkobo/japan-invoice-mcp.git"
  },
  "homepage": "https://github.com/ashkobo/japan-invoice-mcp#readme",
  "bugs": "https://github.com/ashkobo/japan-invoice-mcp/issues",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
